# ============================================================================
# VendorConnect Environment Configuration
# Copy this file to .env and fill in your own credentials.
# Never commit your real .env file to GitHub.
# ============================================================================

# =========================
# Email Configuration
# =========================
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# =========================
# Google OAuth
# =========================
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
GOOGLE_REDIRECT_URI=http://localhost:5000/auth/google/callback

# =========================
# AI / External APIs
# =========================
QUBRID_API_KEY=YOUR_QUBRID_API_KEY
AIML_API_KEY=YOUR_AIML_API_KEY

# =========================
# Google Maps
# =========================
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY

# =========================
# AWS Credentials
# =========================
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY
AWS_REGION=ap-south-1

# =========================
# AWS S3
# =========================
AWS_S3_BUCKET=vendorconnect-media

# =========================
# AWS SNS
# =========================
AWS_SNS_SENDER_ID=VendorConn

# DLT Configuration (India)
AWS_SNS_DLT_ENTITY_ID=YOUR_DLT_ENTITY_ID
AWS_SNS_DLT_TEMPLATE_ID=YOUR_DLT_TEMPLATE_ID

# =========================
# AWS SQS
# =========================
AWS_SQS_GROUP_ORDER_URL=YOUR_SQS_QUEUE_URL

# =========================
# AWS SES
# =========================
AWS_SES_SENDER_EMAIL=your-email@gmail.com

# =========================
# DynamoDB
# =========================
DYNAMO_CHAT_TABLE=vendorconnect_chat
DYNAMO_NOTIF_TABLE=vendorconnect_notifications

# =========================
# AWS Lambda
# =========================
LAMBDA_ORDER_EXPIRY_FN=vendorconnect-order-expiry
LAMBDA_REPORT_FN=vendorconnect-daily-report

# =========================
# EventBridge
# =========================
EVENTBRIDGE_BUS=vendorconnect-events

# =========================
# AWS Location Service
# =========================
LOCATION_ROUTE_CALC=vendorconnect-route-calc
LOCATION_GEOFENCE_COLL=vendorconnect-geofences
LOCATION_TRACKER=vendorconnect-tracker

# =========================
# AWS Personalize
# =========================
PERSONALIZE_CAMPAIGN_ARN=YOUR_PERSONALIZE_CAMPAIGN_ARN
PERSONALIZE_EVENT_TRACKER_ARN=YOUR_PERSONALIZE_EVENT_TRACKER_ARN

# =========================
# AWS Cognito
# =========================
COGNITO_USER_POOL_ID=YOUR_COGNITO_USER_POOL_ID
COGNITO_APP_CLIENT_ID=YOUR_COGNITO_APP_CLIENT_ID

# =========================
# Internal Secret
# =========================
INTERNAL_SECRET=YOUR_INTERNAL_SECRET
