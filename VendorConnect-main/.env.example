# ─────────────────────────────────────────────────────────────────────────────
# VendorConnect – Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# Flask
SECRET_KEY=change-me-to-a-long-random-string
FLASK_ENV=development
FLASK_DEBUG=1

# Database (SQLite by default; override with Postgres/MySQL for production)
DATABASE_URL=sqlite:///vendorconnect.db

# ─── Google OAuth ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ─── Email (SMTP) ─────────────────────────────────────────────────────────────
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-gmail-app-password
MAIL_DEFAULT_SENDER=your-email@gmail.com

# ─── Qubrid AI (Chatbot) ──────────────────────────────────────────────────────
QUBRID_API_KEY=your-qubrid-api-key
QUBRID_API_URL=https://api.qubrid.com/v1/chat

# ─── AWS Core Credentials ─────────────────────────────────────────────────────
# Create an IAM user with programmatic access and attach:
#   AmazonS3FullAccess, AmazonPollyFullAccess, AmazonTranscribeFullAccess,
#   AmazonTranslateFullAccess, AmazonRekognitionFullAccess,
#   AmazonSNSFullAccess, AmazonSQSFullAccess
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
AWS_REGION=ap-south-1

# ─── AWS S3 ───────────────────────────────────────────────────────────────────
# Create a bucket named vendorconnect-media (or override below).
# Enable static website hosting and set a bucket policy for public-read on
# the /uploads/* prefix.
AWS_S3_BUCKET=vendorconnect-media

# ─── AWS SNS (SMS OTP) ────────────────────────────────────────────────────────
# SNS Origination / Sender ID — must match the ID registered in the AWS console.
# For India, request a DLT-registered sender ID or use a numeric short-code.
AWS_SNS_SENDER_ID=VendorConn

# ─── AWS SQS (Group Order Automation) ────────────────────────────────────────
# Create a standard SQS queue named vendorconnect-group-orders.
# Paste the full queue URL here.
AWS_SQS_GROUP_ORDER_URL=https://sqs.ap-south-1.amazonaws.com/123456789012/vendorconnect-group-orders

# ─── Internal API Secret ─────────────────────────────────────────────────────
# Used to authenticate internal cron/lambda → /api/group-orders/process-expired
INTERNAL_SECRET=vendorconnect-internal-change-me

# ─────────────────────────────────────────────────────────────────────────────
# AWS Services quick-reference
# ─────────────────────────────────────────────────────────────────────────────
# Polly  (TTS)       → POST /api/voice/speak          { text, language }
# Transcribe (STT)   → POST /api/voice/transcribe      multipart: audio, language
# Translate          → POST /api/translate             { text|texts, target }
# Translate langs    → GET  /api/translate/languages
# Rekognition        → POST /api/supplier/verify-document  multipart: document
# Rekognition food   → POST /api/product/analyze-image     multipart: image
# SNS SMS OTP        → POST /api/sms/send-otp          { phone, otp, language }
# SQS events         → fired automatically on group-order create/join/complete
# Vendor Analytics   → GET  /vendor/analytics          (browser)
# Vendor Analytics   → GET  /api/vendor/analytics      (JSON)
